{
  "name": "robotics-hub-desktop",
  "version": "1.0.0",
  "description": "Offline desktop wrapper for the Robotics Team Hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.robohub.desktop",
    "productName": "RoboticsHub",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": ["backend.exe"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        },
        {
          "target": "dir",
          "arch": "x64"
        }
      ]
    },
    "portable": {
      "artifactName": "RoboticsHub.exe"
    },
    "asar": true
  }
}
